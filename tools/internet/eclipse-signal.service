[Unit]
Description=Eclipse connection rendezvous and online device directory
After=network-online.target
Wants=network-online.target

[Service]
User=eclipse-signal
Group=eclipse-signal
EnvironmentFile=/etc/eclipse-signal/service.env
ExecStart=/opt/eclipse-signal/current/eclipse-signal --bind ${SIGNAL_BIND} --certificate /etc/eclipse-signal/server.pem --private-key /etc/eclipse-signal/server.key --groups-file /var/lib/eclipse-signal/groups.json --stun ${STUN_URL} --turn-url ${TURN_URL} --turn-secret-file /etc/eclipse-signal/turn.secret --turn-ttl-seconds 86400
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=eclipse-signal
WorkingDirectory=/var/lib/eclipse-signal

[Install]
WantedBy=multi-user.target
