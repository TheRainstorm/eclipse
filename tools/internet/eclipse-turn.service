[Unit]
Description=Eclipse STUN and authenticated TURN relay
After=network-online.target
Wants=network-online.target

[Service]
User=turnserver
Group=turnserver
ExecStart=/usr/bin/turnserver -c /etc/eclipse-turn/turnserver.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=eclipse-turn
WorkingDirectory=/run/eclipse-turn
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
